# Environment variables для разработки
# Скопируйте этот файл в .env и заполните значения

# Application
NODE_ENV=development
PORT=3000

# Database (через SSH туннель)
# Подключение к удалённой БД через SSH туннель на localhost:15432
DB_HOST=localhost
DB_PORT=15432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=focusima_dev

# TypeORM
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_MIGRATIONS_RUN=true

# Production Database (для справки)
# DB_HOST=your-remote-host.com
# DB_PORT=5432
# DB_USERNAME=your-prod-username
# DB_PASSWORD=your-prod-password
# DB_DATABASE=focusima_prod
# DB_SYNCHRONIZE=false
# DB_LOGGING=false
# DB_MIGRATIONS_RUN=false
